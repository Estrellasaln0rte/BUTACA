{
  "name": "butaca",
  "private": true,
  "version": "0.1.0",
  "description": "Butaca: recomendaciones de películas y series según tu ánimo (TMDB + detección de emoción).",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:front": "npm run dev --workspace frontend",
    "dev:back": "npm run dev --workspace backend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "playwright test --config e2e/playwright.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2"
  }
}
