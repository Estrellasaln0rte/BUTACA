# Copiá este archivo como .env y completá los valores reales.
# El .env NUNCA se sube al repositorio (está en .gitignore).

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# TMDB: themoviedb.org > Settings > API (solo vive en el backend)
TMDB_API_KEY=tu-api-key-de-tmdb

# Supabase > Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase > Project Settings > API (para verificar el token de sesión del usuario)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key

# Opción B de detección de emoción (solo si eligen AWS Rekognition)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
