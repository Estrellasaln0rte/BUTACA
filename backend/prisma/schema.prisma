// Esquema de Prisma conectado a Supabase (PostgreSQL).
// Docs: https://www.prisma.io/docs/orm/overview/databases/supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexión con pooler (puerto 6543)
  directUrl = env("DIRECT_URL")   // conexión directa para migraciones (puerto 5432)
}

// Entidades de la aplicación:
//  - Usuario (id de Supabase Auth)
//  - Registro de ánimo (emoción detectada + fecha)
//  - Recomendación (qué se recomendó para ese ánimo: géneros / ids de TMDB)
//  - Favorito (película o serie de TMDB guardada por el usuario)
// Recordatorio: NUNCA guardar la imagen de la cámara, solo la emoción.

model Profile {
  // Es el UUID de Supabase Auth, no un UUID nuevo generado por Prisma.
  // La FK a auth.users(id) se mantiene en SQL para no administrar auth con Prisma.
  id        String   @id @db.Uuid
  createdAt DateTime @default(now())

  moods           Mood[]
  favorites       Favorite[]
  recommendations Recommendation[]

  @@map("profiles")
}

model Mood {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  emotion    String
  confidence Float?
  createdAt  DateTime  @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("moods")
}

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tmdbId     Int
  mediaType  String
  title      String
  posterPath String?
  createdAt  DateTime @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaType, tmdbId])
  @@index([userId])
  @@map("favorites")
}

model Recommendation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  emotion   String
  mediaType String
  tmdbId    Int
  genreIds  Int[]
  createdAt DateTime @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("recommendations")
}
